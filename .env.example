# Alamat publik galeri (dipakai di QR). Tanpa garis miring di akhir.
PUBLIC_URL=https://foto.domainanda.com

# Login halaman admin: https://foto.domainanda.com/admin
ADMIN_USER=admin
ADMIN_PASSWORD=ganti-dengan-password-panjang

# Alamat app kasir (untuk memeriksa token studio — token yang SAMA dengan yang dipakai booth untuk sinkron ke kasir).
# Boleh kosong bila memakai STUDIO_TOKENS.
KASIR_URL=https://kasir.domainanda.com

# Cadangan tanpa kasir: token:Nama Studio, dipisah koma (opsional)
# STUDIO_TOKENS=

# Masa simpan awal (hari). Bisa diubah di halaman admin.
RETENTION_DAYS=7
